# runs/ 默认全忽略（权重/大视频/抽帧不入库），但证据类文件白名单入库
runs/**
!runs/**/
!runs/p0/**/report.json
!runs/p0/**/retarget_qa.json
!runs/w6/gate3_qpos.json
!runs/p0/**/curve.csv
# clean-lift feasibility evidence: the verdict, the diagnosis that grounds it, the
# full per-trial sweep distribution and the evaluation traces. A FAIL verdict
# rests on these, so they belong in the repo like report.json does.
!runs/p0/**/clean_lift_verdict.json
!runs/p0/**/clean_lift_diagnose.json
!runs/p0/**/clean_lift_sweep.json
!runs/p0/**/eval_episodes.json
!runs/p0/**/eval_episodes_len250.json
!runs/p0/**/eval_episodes_len400.json
!runs/p0/**/train_summary.json
# reachable-class demo set (round p0(4)): the D4 npz the replay test pins
!runs/p0/**/reachable_demo_set.npz
# W6b data deliverable: the per-frame MANO parameter stream the dual-hand
# retarget consumes (same evidence class as the pinned reachable_demo_set.npz)
!runs/w6b/mano_params.npz
!runs/w6b/mano_params.meta.json
!runs/w6b/mano_params_fullfps.npz
!runs/w6b/mano_params_fullfps.meta.json
!runs/w6b/wrist_landmarks.npz
!runs/w6b/report.json
!runs/w6b/replay_frames.json
!runs/w6b/evidence/*.png
!runs/p0/**/SUMMARY.md
# P1 threshold sign-off material (measured P0 distributions per gate),
# regenerated by scripts/p0_summary.py — same evidence class as SUMMARY.md.
!runs/p0/**/p1_threshold_calibration.md
!runs/p0/**/BLOCKER.md
!runs/p0/assets/MANIFEST.md
!runs/p0/**/evidence/*.png

__pycache__/
*.pyc
.venv/
*.pt
*.pth
*.onnx
*.mp4
*.pkl
frames/
weights/
.DS_Store

# Evidence scripts backing REVISION.md refutations must be reproducible from a
# clean checkout (BoxLipVerify flag). Numbers live in REVISION.md; the scripts
# that regenerate them are tracked; large JSON/pickle payloads stay ignored.
!runs/w4/*.py
!runs/w35/*.py
!runs/w5/*.py
# W6c lift-training evidence: honest-fail verdict, curation, frozen-gate evals,
# search/BC curves and the lift-attempt frames (same class as w6b report.json)
!runs/w6c/report.json
!runs/w6c/curation.json
!runs/w6c/checkpoint_meta.json
!runs/w6c/teacher.json
!runs/w6c/eval_bc.json
!runs/w6c/eval_ppo.json
!runs/w6c/bc_curve.json
!runs/w6c/ppo_curve.csv
!runs/w6c/search_curve.json
!runs/w6c/bc_demos.npz
!runs/w6c/approach_checkpoint.npz
!runs/w6c/v20_lift.py
!runs/w6c/v20_grid.json
!runs/w6c/evidence/*.png
